{
  "name": "berrymark",
  "version": "0.0.1-alpha.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "npm ci && node --test",
    "studio": "node src/studio/studio-cli.js",
    "check": "node src/cli.js check examples/hello-world.berry.md",
    "preview": "node src/cli.js preview examples/hello-world.berry.md",
    "compile": "node src/compiler-cli.js examples/compiler-all-blocks.berry.md",
    "compile:rejoice": "node src/compiler-cli.js examples/rejoice-always/rejoice-always.berry.md",
    "plan": "node src/import-plan-cli.js examples/compiler-all-blocks.compiled.json --source examples/compiler-all-blocks.berry.md",
    "plan:artifact": "node src/import-plan-cli.js examples/compiler-all-blocks.compiled.json",
    "plan:online": "node src/online-import-plan-cli.js examples/rejoice-always/rejoice-always.berry.md",
    "apply:draft": "node src/sanity-draft-apply-cli.js examples/rejoice-always/rejoice-always.berry.md"
  },
  "dependencies": {
    "marked": "18.1.3",
    "yaml": "2.9.1"
  }
}
